# 复制为服务器上的环境变量文件或交给进程管理器加载，不要提交真实值。
SERVER_PORT=8081
DB_URL=jdbc:mysql://127.0.0.1:3306/enterprise_work_order?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=true&allowPublicKeyRetrieval=false
DB_USERNAME=enterprise_work_order
DB_PASSWORD=replace-with-a-dedicated-database-password
DB_POOL_SIZE=20
DB_MIN_IDLE=5
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRE_HOURS=8
CORS_ALLOWED_ORIGINS=https://workorder.example.com
ATTACHMENT_STORAGE_ROOT=/srv/enterprise-work-order/data/attachments
ATTACHMENT_MAX_SIZE=20MB
UPLOAD_MAX_FILE_SIZE=25MB
UPLOAD_MAX_REQUEST_SIZE=30MB
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
