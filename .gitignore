# ==================== 构建产物 ====================
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ==================== IntelliJ IDEA ====================
.idea/
*.iws
*.iml
*.ipr
out/

# ==================== 本地配置（含数据库密码，禁止提交）====================
src/main/resources/application-local.yml
src/main/resources/application-local.yaml
src/main/resources/application-local.properties

# ==================== 日志 ====================
logs/
*.log

# ==================== 操作系统 ====================
.DS_Store
Thumbs.db
desktop.ini
# ==================== 手工备份快照（已被 git 取代）====================
# backup/ 是 git 之前手写的源码快照，与正式源码重复；
# 其中 20260920-backend*/src/main/resources/application-local.yml 含数据库明文密码，
# 一旦入库就等于把密码永久写进历史，故整目录排除。
backup/
# ==================== 端到端测试产物 ====================
# 导出用例生成的 xlsx 样本与断言报告都是本机跑出来的临时结果，
# 每次执行都会覆盖，没有版本价值。
e2e/export-out/
e2e/*-report.txt
# ==================== 附件存储目录 ====================
# 用户上传的附件落在 data/attachments 下，属于运行期数据：
# 体积随使用增长、与代码无关，且换台机器就该是空的，不入库。
data/
